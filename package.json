{
  "name": "@refokus-agency/feature-engine",
  "version": "1.3.0",
  "type": "module",
  "description": "Declarative feature loading system with code splitting for Webflow projects",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "README.md",
    "LICENSE"
  ],
  "author": "",
  "keywords": [
    "webflow",
    "feature-loading",
    "code-splitting",
    "vite",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/refokus-agency/feature-engine.git"
  },
  "bugs": {
    "url": "https://github.com/refokus-agency/feature-engine/issues"
  },
  "homepage": "https://github.com/refokus-agency/feature-engine#readme",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run check-types && npm run lint && npm run build:clean",
    "check-types": "tsc --noEmit --strict --skipLibCheck -p tsconfig.eslint.json",
    "lint": "eslint src --ext .ts --fix",
    "lint:report": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "bench": "vitest bench",
    "commit": "cz"
  },
  "dependencies": {
    "acorn": "^8.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^24.0.10",
    "@types/webidl-conversions": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitest/ui": "^3.2.4",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "^17.21.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
