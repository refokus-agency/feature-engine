{
  "name": "@refokus-agency/feature-engine",
  "version": "0.0.0-development",
  "type": "module",
  "description": "Declarative feature loading system with code splitting for Webflow projects",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "author": "Refokus LLC",
  "keywords": [
    "webflow",
    "feature-loading",
    "code-splitting",
    "vite",
    "typescript",
    "lazy-loading",
    "esm",
    "browser",
    "dependency-graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refokus-agency/feature-engine.git"
  },
  "bugs": {
    "url": "https://github.com/refokus-agency/feature-engine/issues"
  },
  "homepage": "https://github.com/refokus-agency/feature-engine#readme",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build:clean",
    "typecheck": "tsc --noEmit --strict --skipLibCheck -p tsconfig.eslint.json",
    "lint": "biome lint --write ./src",
    "lint:report": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "bench": "vitest bench",
    "commit": "cz"
  },
  "dependencies": {
    "acorn": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^26.2.0",
    "@types/webidl-conversions": "^7.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
