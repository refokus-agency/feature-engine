{
    "extends": "@total-typescript/tsconfig/tsc/no-dom/library",
    "compilerOptions": {
      "outDir": "./dist",
      "rootDir": "./src",
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "rewriteRelativeImportExtensions": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "declaration": true
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "src/**/*.spec.ts",
      "src/**/*.test.ts",
      "src/**/__tests__/**"
    ]
}